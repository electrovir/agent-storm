{
    "name": "agent-storm",
    "private": true,
    "homepage": "https://github.com/electrovir/agent-storm",
    "bugs": {
        "url": "https://github.com/electrovir/agent-storm/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/agent-storm.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "compile": "virmator compile",
        "format": "virmator format",
        "init": "tsx packages/scripts/src/init.script.ts",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "npm run init && tsx packages/scripts/src/start.script.ts",
        "start:debug": "AGENT_STORM_INSTANCE=debug AGENT_STORM_DATA_DIR=\"$HOME/.agent-storm-debug\" BACKEND_PORT=41890 FRONTEND_PORT=41891 npm start",
        "test": "mono-vir for-each-async npm run test",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,docs,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "mono-vir for-each-async npm run test:update"
    },
    "overrides": {
        "esbuild": "^0.28.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "cspell": "^10.4.0",
        "dependency-cruiser": "^18.7.2",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^65.4.2",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.12.2",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unicorn": "^79.0.0",
        "markdown-code-example-inserter": "^3.1.2",
        "mono-vir": "^2.5.1",
        "npm-check-updates": "^23.1.1",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "~4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.1.0",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^4.1.0",
        "runstorm": "^1.1.0",
        "typescript-eslint": "8.72.1",
        "virmator": "^14.38.0"
    },
    "engines": {
        "node": ">=22"
    }
}
